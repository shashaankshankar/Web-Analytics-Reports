{
  "displayName": "Measurement Platform OAuth Callback Health",
  "monitoredResource": {
    "type": "uptime_url",
    "labels": {
      "host": "measurement-oauth-callback-ptlwmdunva-uc.a.run.app",
      "project_id": "web-analytics-agency-prod"
    }
  },
  "httpCheck": {
    "requestMethod": "GET",
    "useSsl": true,
    "validateSsl": true,
    "path": "/health",
    "port": 443,
    "acceptedResponseStatusCodes": [
      { "statusValue": 200 }
    ]
  },
  "contentMatchers": [
    {
      "matcher": "MATCHES_JSON_PATH",
      "content": "\"ok\"",
      "jsonPathMatcher": {
        "jsonPath": "$.status",
        "jsonMatcher": "EXACT_MATCH"
      }
    }
  ],
  "period": "60s",
  "timeout": "10s",
  "selectedRegions": ["USA_IOWA", "USA_OREGON", "USA_VIRGINIA"],
  "userLabels": {
    "environment": "production",
    "service": "measurement-oauth-callback"
  }
}
