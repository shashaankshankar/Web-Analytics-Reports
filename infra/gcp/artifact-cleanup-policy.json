[
  {
    "name": "delete-versions-after-30-days",
    "action": { "type": "Delete" },
    "condition": {
      "tagState": "any",
      "olderThan": "2592000s"
    }
  },
  {
    "name": "keep-ten-most-recent-versions",
    "action": { "type": "Keep" },
    "mostRecentVersions": {
      "keepCount": 10
    }
  }
]
