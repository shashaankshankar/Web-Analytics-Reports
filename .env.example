# Keep secrets out of source control. The application remains in demo/disabled mode
# until all required values and a reviewed analytics assignment are supplied.
PORT=3000
HOST=127.0.0.1
PLATFORM_MODE=demo
DATABASE_URL=postgresql://measurement_app:replace-me@127.0.0.1:5432/measurement
DB_NAME=measurement
DB_USER=measurement_app
DB_PASSWORD=
INSTANCE_UNIX_SOCKET=
PLATFORM_AUTH_MODE=token
GOOGLE_CLOUD_PROJECT=web-analytics-agency-prod
GOOGLE_CLOUD_REGION=us-central1
CLOUD_TASKS_QUEUE=measurement-sync
SERVICE_URL=
TASK_SERVICE_ACCOUNT=
INTERNAL_TRIGGER_TOKEN=
# Leave empty when using Application Default Credentials (ADC) impersonation.
# GOOGLE_APPLICATION_CREDENTIALS_JSON is supported only for legacy JSON-key auth.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_SERVICE_ACCOUNT_SUBJECT=
GA4_ADMIN_API_ENABLED=false
GA4_DATA_API_ENABLED=false
GA4_LIVE_APPROVED=false
# Canonical non-secret identifiers for the first live website.
GA4_PROPERTY_ID=549721844
GA4_STREAM_ID=15427015396
# Required before any live-mode HTTP endpoint is exposed.
PLATFORM_API_TOKEN=
PLATFORM_OPERATOR_EMAIL=
# Store REPORT_EMAIL_API_KEY and REPORT_RECIPIENTS_JSON in Secret Manager in production.
# The recipient JSON maps non-sensitive aliases stored in Postgres to addresses kept in the secret.
REPORT_EMAIL_API_KEY=
REPORT_EMAIL_FROM=
REPORT_RECIPIENTS_JSON={}
REPORT_EMAIL_ENDPOINT=https://api.resend.com/emails
# OAuth remains disabled until the Google production consent-screen gate is approved.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_KMS_KEY=
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_PRODUCTION_APPROVED=false
