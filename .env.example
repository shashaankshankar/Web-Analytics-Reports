# Automated AI Growth Briefings & Local SEO Intelligence Engine Configuration

# AI / LLM Provider Configuration (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.6-luna
LLM_REASONING_MODE=standard
LLM_REASONING_EFFORT=medium

# Transactional Email Dispatcher (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=growth@youragency.com

# Google Cloud / Service Account Credentials for GA4 and Search Console
# Leave blank only when Application Default Credentials are already available.
GOOGLE_APPLICATION_CREDENTIALS=

# Private Google Business Profile OAuth bundle. In production inject this as
# a Secret Manager-backed environment variable; never commit the JSON value.
GBP_OAUTH_CREDENTIALS_JSON=
# Optional fallback account resource ID (the client config can also resolve it
# automatically by matching the configured public Place ID).
GBP_ACCOUNT_ID=

# OAuth callback service settings. The client secret is callback-service-only
# and must be injected from Secret Manager; never commit or print its value.
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GBP_OAUTH_REDIRECT_URI=https://measurement-oauth-callback-ptlwmdunva-uc.a.run.app/oauth/google/callback
GBP_OAUTH_SECRET_ID=GBP_OAUTH_CREDENTIALS_JSON
GBP_OAUTH_EXPECTED_PLACE_ID=ChIJM7fB_p1v54gR35t3HRaGH_Q
GCP_PROJECT_ID=

# Never enable this in the reporting service. It is only for explicit local
# development when testing with ADC instead of the user OAuth bundle.
GBP_ALLOW_ADC_FALLBACK=false

# Production dispatch safety. Leave disabled locally.
REPORT_DELIVERY_ENABLED=false
REPORT_ALLOWED_CLIENTS=thehouseofdental
