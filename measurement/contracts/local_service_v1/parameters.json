{
  "contract_id": "local_service_v1",
  "allowed": {
    "location": {
      "type": "string",
      "values": ["header", "hero", "body", "footer", "mobile_nav", "contact", "services", "unknown"],
      "required_for": ["phone_click", "email_click", "cta_click"]
    },
    "form_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$",
      "required_for": ["form_start", "form_submit", "generate_lead", "appointment_request"]
    },
    "cta_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$",
      "required_for": ["cta_click"]
    },
    "link_type": {
      "type": "string",
      "values": ["tel", "mailto", "internal", "external"],
      "required_for": ["phone_click", "email_click", "cta_click"]
    }
  },
  "optional": {
    "page_template": {"type": "string", "pattern": "^[a-z0-9_-]{1,64}$"},
    "contract_version": {"type": "string", "pattern": "^local_service_v1$"}
  },
  "prohibited": [
    "name", "full_name", "email", "phone", "telephone", "personal_phone",
    "message", "form_contents", "patient_id", "patient_identifier",
    "appointment_id", "appointment_identifier", "treatment", "condition",
    "diagnosis", "medical_details", "health_information", "date_of_birth"
  ],
  "prohibited_sources": [
    "query_parameters", "form_values", "page_title", "document_referrer",
    "site_search_terms", "campaign_parameters", "url_path_with_identifier"
  ],
  "unknown_parameter_behavior": "reject_event"
}
